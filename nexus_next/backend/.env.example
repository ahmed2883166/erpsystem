DJANGO_SECRET_KEY=replace-this-for-local-development
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
POSTGRES_DB=nexus_dev
POSTGRES_USER=nexus_app
POSTGRES_PASSWORD=replace-with-a-strong-local-password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Production example only: terminate TLS at a trusted reverse proxy in front of Waitress.
# The proxy must remove client-supplied X-Forwarded-Proto and set it to "https".
# Set CSRF_TRUSTED_ORIGINS to the actual HTTPS origin used by the company.
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=True
# DJANGO_HTTPS_TERMINATED_BY_PROXY=True
# CSRF_TRUSTED_ORIGINS=https://erp.company.example

# Optional Windows LAN production settings (use with start-production.ps1 -EnableLan).
# Set DJANGO_ENV=production for start-production.ps1.
# Use a fixed internal DNS name; point it to the server's reserved LAN IP.
# ADMRAIL_LAN_HOST=erp.company.lan
# DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,erp.company.lan
# CSRF_TRUSTED_ORIGINS=https://erp.company.lan
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=True
# DJANGO_HTTPS_TERMINATED_BY_PROXY=True
